<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Data &amp; Analytics — SpiderRock</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/js/tailwind-config.js"></script>
  <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="font-sans antialiased text-[#3B3F40]">

{% include "partials/header.njk" %}

  <!-- ─── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="hero-steel text-white">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow eyebrow-dark mb-5">Data &amp; Analytics</p>
        <h1 class="hero-h1 mb-6">Options Data &amp;<br>Analytics</h1>
        <p class="hero-lead mb-9">
          Institutional-grade options data and real-time analytics for research and production trading. Not resold third-party feeds — powered by the same engine that manages live institutional trading.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="../contact-us/" class="btn btn-primary">Get Access</a>
          <a href="https://docs.spiderrockconnect.com/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View Documentation&nbsp;<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <nav class="dark-panel" aria-labelledby="offerings-label">
        <p id="offerings-label" class="dark-panel-label">Our Offerings</p>
        <a href="stocks-options-futures/" class="offer-row">
          <span><span class="offer-title">Real-Time Data</span><span class="offer-sub">Raw &amp; normalized multicast feeds</span></span>
          <span class="offer-arrow" aria-hidden="true">→</span>
        </a>
        <a href="options-analytics/" class="offer-row">
          <span><span class="offer-title">Options Analytics</span><span class="offer-sub">OPRA · CME · NBBO implied volatility</span></span>
          <span class="offer-arrow" aria-hidden="true">→</span>
        </a>
        <a href="historical-data-analytics/options-greeks-stock-prices/" class="offer-row">
          <span><span class="offer-title">Historical Data</span><span class="offer-sub">AWS S3 · Snowflake · REST API</span></span>
          <span class="offer-arrow" aria-hidden="true">→</span>
        </a>
      </nav>
    </div>
  </section>

  <!-- ─── THREE PRODUCT TIERS ───────────────────────────────────────────────── -->
  <section class="bg-white section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow mb-3">Our Data &amp; Analytics</p>
        <h2 class="h2">Three Product Tiers</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-7">

        <div id="realtime" class="card card-accent bg-white">
          <h3 class="card-title-3 mb-3">Real-Time Data</h3>
          <p class="lead mb-5">Raw and normalized feeds for US and European markets.</p>
          <ul class="bullets mb-8">
            <li>Equity, options, and futures data via multicast channels and TCP connection</li>
            <li>Reduced-bandwidth normalized format</li>
            <li>Client-side APIs built for low latency</li>
          </ul>
          <a href="stocks-options-futures/" class="arrow-link mt-auto">Learn More <span class="arrow">→</span></a>
        </div>

        <div id="options-analytics" class="card card-accent bg-white">
          <h3 class="card-title-3 mb-3">Options Analytics</h3>
          <p class="lead mb-5">Adaptive pricing for all US-listed options and options on futures.</p>
          <ul class="bullets mb-8">
            <li>NBBO implied volatility quotes</li>
            <li>Theoretical surface prices and Greeks</li>
            <li>Normalized OPRA and CME, plus trade prints</li>
          </ul>
          <a href="options-analytics/" class="arrow-link mt-auto">Learn More <span class="arrow">→</span></a>
        </div>

        <div id="historical" class="card card-accent bg-white">
          <h3 class="card-title-3 mb-3">Historical Data</h3>
          <p class="lead mb-5">Multi-asset history for research and data-driven decisions.</p>
          <ul class="bullets mb-8">
            <li>Volatility surfaces, implied vols, and skew slopes</li>
            <li>Greeks plus stock, option, and futures prices and prints</li>
            <li>Delivered via AWS S3 (Parquet), Snowflake, or REST API</li>
          </ul>
          <a href="historical-data-analytics/options-greeks-stock-prices/" class="arrow-link mt-auto">Learn More <span class="arrow">→</span></a>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── DATA DELIVERY ─────────────────────────────────────────────────────── -->
  <section id="delivery" class="bg-sr-mist section scroll-mt-[90px]">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow mb-3">Data Delivery</p>
        <h2 class="h2">How We Deliver Data</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-7">
        <div class="card bg-white">
          <h3 class="card-title-2 mb-3">Multicast Feeds</h3>
          <p class="lead mb-4">Low-latency raw and normalized feeds.</p>
          <ul class="bullets mb-7">
            <li>US equities, options, and futures</li>
            <li>European venues via Eurex, Euronext, ICE Europe, and Cboe Europe</li>
            <li>Reduced bandwidth, full data integrity</li>
          </ul>
          <a href="stocks-options-futures/" class="arrow-link mt-auto">Exchange feeds &amp; coverage <span class="arrow">&rarr;</span></a>
        </div>
        <div class="card bg-white">
          <h3 class="card-title-2 mb-3">Live APIs</h3>
          <p class="lead mb-4">Live market data and analytics on demand.</p>
          <ul class="bullets mb-7">
            <li>Stocks, ETFs, options, and futures</li>
            <li>WebSocket and REST via SpiderStream over MLink</li>
            <li>Real-time or delayed</li>
          </ul>
          <a href="spiderstream-market-data-api/" class="arrow-link mt-auto">SpiderStream / MLink API <span class="arrow">&rarr;</span></a>
        </div>
        <div class="card bg-white">
          <h3 class="card-title-2 mb-3">Historical Datasets</h3>
          <p class="lead mb-4">10+ years of end-of-day and intraday history.</p>
          <ul class="bullets mb-7">
            <li>Options pricing, Greeks, implied volatility, and equity prices</li>
            <li>Parquet on AWS S3 or queried in Snowflake</li>
            <li>Built for backtesting and research</li>
          </ul>
          <a href="historical-data-analytics/options-greeks-stock-prices/" class="arrow-link mt-auto">Historical data products <span class="arrow">&rarr;</span></a>
        </div>
        <div class="card bg-white">
          <h3 class="card-title-2 mb-3">AWS &amp; Infrastructure</h3>
          <p class="lead mb-4">Use the tools your team already runs.</p>
          <ul class="bullets mb-7">
            <li>Parquet files on AWS S3</li>
            <li>Query in place through a Snowflake reader account</li>
          </ul>
          <a href="aws-infrastructure/" class="arrow-link mt-auto">AWS &amp; Snowflake delivery <span class="arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FEATURED NEWS ─────────────────────────────────────────────────────── -->
  <!-- The newest Data & Analytics posts (collections.dataPosts), so it updates with the blog. -->
{%- set featured = collections.dataPosts | head(3) %}
{%- set newsTitle = "Latest from Data & Analytics" %}
{% include "partials/featured-news.njk" %}

  <!-- ─── CTA ──────────────────────────────────────────────────────────────── -->
  <section class="bg-sr-mist section">
    <div class="wrap cta-band">
      <div>
        <h2 class="h2 mb-4">Let Us Help</h2>
        <p class="body-copy text-[18px]">Leverage the right data for your needs. Talk to our team of experts to find the right data solution for you.</p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="../contact-us/" class="btn btn-primary">Contact Us</a>
        <a href="https://docs.spiderrockconnect.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Documentation&nbsp;<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

{% include "partials/footer.njk" %}

</body>
</html>
