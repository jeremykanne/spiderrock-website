<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Data &amp; Analytics — SpiderRock</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/js/tailwind-config.js"></script>
  <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="font-sans antialiased text-[#3B3F40]">

{% include "partials/header.njk" %}

  <!-- ─── HERO ─────────────────────────────────────────────────────────────── -->

  <section class="hero-steel text-white">
    <div class="wrap pt-20 pb-24">
      <p class="eyebrow eyebrow-dark mb-5">Data &amp; Analytics</p>
      <h1 class="hero-h1 mb-6">Options Data &amp;<br>Analytics</h1>
      <p class="hero-lead mb-9">
        Institutional-grade options data and real-time analytics for research and production trading. Not resold third-party feeds — powered by the same engine that manages live institutional trading.
      </p>
      <a href="../contact-us/" class="btn btn-primary">Get Access</a>
    </div>
  </section>

  <!-- ─── THREE PRODUCT TIERS ───────────────────────────────────────────────── -->
  <section class="bg-white section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow mb-3">Our Data &amp; Analytics</p>
        <h2 class="h2">Three Product Tiers</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-7">

        <div id="realtime" class="card card-accent bg-sr-mist">
          <h3 class="card-title-3 mb-4">Real-Time Data</h3>
          <p class="body-copy mb-8">
            SpiderRock delivers raw and normalized US and European equity, options, and futures data feeds via multicast channels. Our normalized feed provides a reduced bandwidth profile for better manageability and cost effectiveness, and our client-side APIs turn high multicast packet volumes into individual messages at low latencies.
          </p>
          <a href="stocks-options-futures/" class="arrow-link mt-auto">Learn More <span class="arrow">→</span></a>
        </div>

        <div id="options-analytics" class="card card-accent bg-sr-mist">
          <h3 class="card-title-3 mb-4">Options Analytics</h3>
          <p class="body-copy mb-8">
            Our highly accurate and adaptive pricing methods cover all US-listed options and options on futures. By incorporating data from our API environment into our analytics framework, we offer a low-latency analytics feed providing options content including normalized OPRA and CME, NBBO implied volatility quotes, theoretical surface prices, Greeks, and trade prints.
          </p>
          <a href="options-analytics/" class="arrow-link mt-auto">Learn More <span class="arrow">→</span></a>
        </div>

        <div id="historical" class="card card-accent bg-sr-mist">
          <h3 class="card-title-3 mb-4">Historical Data</h3>
          <p class="body-copy mb-8">
            SpiderRock has a suite of historical data products in multiple asset classes with the ability to deliver data via flat files and RESTful API. Our market data and analytics enable data-driven decisions by examining historical theoretical volatility surfaces, implied volatilities, skew slopes, Greeks, and stock, option, and futures price and print information.
          </p>
          <a href="historical-data-analytics/options-greeks-stock-prices/" class="arrow-link mt-auto">Learn More <span class="arrow">→</span></a>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── DATA DELIVERY ─────────────────────────────────────────────────────── -->
  <section class="bg-sr-mist section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow mb-3">Data Delivery</p>
        <h2 class="h2">How We Deliver Data</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-7">
        <div class="card bg-white">
          <h3 class="card-title-2 mb-4">Multicast Feeds</h3>
          <p class="body-copy mb-8">
            Raw and normalized low-latency multicast feeds covering US equities, options, and futures, plus European venues via Eurex and Euronext. The normalized format reduces bandwidth while preserving the data integrity institutional workflows require.
          </p>
          <a href="stocks-options-futures/" class="arrow-link mt-auto">Exchange feeds &amp; coverage <span class="arrow">&rarr;</span></a>
        </div>
        <div class="card bg-white">
          <h3 class="card-title-2 mb-4">Live APIs</h3>
          <p class="body-copy mb-8">
            API access to live market data and analytics for single stocks, ETFs, options, and futures. SpiderStream over MLink provides WebSocket and REST access to real-time and delayed institutional-grade data.
          </p>
          <a href="spiderstream-market-data-api/" class="arrow-link mt-auto">SpiderStream / MLink API <span class="arrow">&rarr;</span></a>
        </div>
        <div class="card bg-white">
          <h3 class="card-title-2 mb-4">Historical Datasets</h3>
          <p class="body-copy mb-8">
            10+ years of end-of-day and intraday history &mdash; options pricing, Greeks, implied volatility, and equity prices &mdash; delivered as Parquet files on AWS S3 or queried in place through Snowflake for backtesting and research.
          </p>
          <a href="historical-data-analytics/options-greeks-stock-prices/" class="arrow-link mt-auto">Historical data products <span class="arrow">&rarr;</span></a>
        </div>
        <div class="card bg-white">
          <h3 class="card-title-2 mb-4">AWS &amp; Infrastructure</h3>
          <p class="body-copy mb-8">
            Historical data as Parquet files on AWS S3, or queried in place through a Snowflake reader account &mdash; using the tools your team already runs.
          </p>
          <a href="aws-infrastructure/" class="arrow-link mt-auto">AWS &amp; Snowflake delivery <span class="arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── STATS CALLOUT ─────────────────────────────────────────────────────── -->
  <section class="bg-sr-navy py-20">
    <div class="wrap">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="stat">
          <div class="stat-figure">10+</div>
          <p class="stat-label">Years of Historical Data</p>
        </div>
        <div class="stat">
          <div class="stat-figure">100%</div>
          <p class="stat-label">US-Listed Options Coverage</p>
        </div>
        <div class="stat">
          <div class="stat-figure">Live</div>
          <p class="stat-label">Greeks &amp; Implied Vols</p>
        </div>
        <div class="stat">
          <div class="stat-figure">SOC-II</div>
          <p class="stat-label">Compliant Infrastructure</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FEATURED NEWS ─────────────────────────────────────────────────────── -->
  <!-- Built from the newest Data & Analytics posts (collections.dataPosts), the same three
       that lead /data/updates/, so it updates whenever the blog does. -->
  <section class="bg-white section">
    <div class="wrap">
      <div class="section-head flex flex-wrap justify-between items-end gap-4">
        <div>
          <p class="eyebrow mb-3">Featured News</p>
          <h2 class="h2">Latest from Data &amp; Analytics</h2>
        </div>
        <a href="../updates/" class="arrow-link mb-2">View All Updates <span class="arrow">→</span></a>
      </div>
      {%- set featured = collections.dataPosts | head(3) %}
      {%- set hideLatestLabel = true %}
      {% include "partials/latest-news.njk" %}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-sr-mist section">
    <div class="wrap text-center">
      <h2 class="h2 mb-5">Let Us Help</h2>
      <p class="text-gray-600 text-[18px] leading-relaxed max-w-[38em] mx-auto mb-9">Leverage the right data for your needs. Talk to our team of experts to find the right data solution for you.</p>
      <a href="../contact-us/" class="btn btn-contact">Contact Us</a>
    </div>
  </section>

{% include "partials/footer.njk" %}

</body>
</html>
