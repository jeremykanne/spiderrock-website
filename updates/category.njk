---
pagination:
  data: collections.categoryPages
  size: 1
  alias: cp
permalink: "{{ cp.url }}index.html"
eleventyComputed:
  title: "{{ cp.name }}"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ cp.name }} — News &amp; Updates — SpiderRock</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/js/tailwind-config.js"></script>
  <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="font-sans antialiased text-gray-900">

{% include "partials/header.njk" %}

  <!-- ─── HERO ─────────────────────────────────────────────────────────────── -->

  <section class="hero-steel text-white">
    <div class="wrap pt-20 pb-24">
      <p class="eyebrow eyebrow-dark mb-5"><a href="/updates/" class="hover:text-white transition-colors">News &amp; Updates</a></p>
      <h1 class="hero-h1 mb-6 max-w-3xl">{{ cp.name }}</h1>
      <p class="hero-lead">{{ cp.count }} {{ "update" if cp.count == 1 else "updates" }} from SpiderRock, newest first.</p>
    </div>
  </section>

  <!-- ─── NEWS LISTING ─────────────────────────────────────────────────────── -->
  <section class="bg-white section">
    <div class="wrap">

      {%- set activeCategory = cp.slug %}
      {% include "partials/category-filter.njk" %}

      <!-- MORE NEWS LIST -->
      <div>
        <p class="eyebrow mb-8">{{ cp.name }} &mdash; {{ cp.count }} {{ "post" if cp.count == 1 else "posts" }}{% if cp.total > 1 %} &middot; Page {{ cp.pageNumber + 1 }} of {{ cp.total }}{% endif %}</p>
        <div class="divide-y divide-gray-200">
{%- for post in cp.posts %}
{% include "partials/news-row.njk" %}
{%- endfor %}
        </div>
      </div>

      {%- set pager = { hrefs: cp.hrefs, current: cp.pageNumber, previous: cp.previous, next: cp.next } %}
      {% include "partials/pager.njk" %}

      <div class="mt-12 text-center">
        <a href="/contact-us/" class="btn btn-outline">Contact Us →</a>
      </div>
    </div>
  </section>

{% include "partials/footer.njk" %}

</body>
</html>
