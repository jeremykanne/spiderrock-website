            <button class="flex items-center gap-1 hover:text-blue-200 transition-colors duration-200 cursor-pointer">Featured Products <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button>
            <div class="absolute top-full left-0 pt-2 hidden group-hover:block z-50">
              <div class="bg-sr-navy border border-white/20 rounded-lg shadow-2xl py-2 min-w-[250px]">
                <a href="/data/dividend-forecast/" class="block px-4 py-2 text-white/90 hover:text-blue-200 hover:bg-white/10 text-[0.85rem] transition-colors">SpiderRock Dividend Forecast</a><a href="/data/european-data/" class="block px-4 py-2 text-white/90 hover:text-blue-200 hover:bg-white/10 text-[0.85rem] transition-colors">European Data</a><a href="/data/spiderstream-market-data-api/" class="block px-4 py-2 text-white/90 hover:text-blue-200 hover:bg-white/10 text-[0.85rem] transition-colors">MLink API</a><a href="/data/historical-data-analytics/vol2g/" class="block px-4 py-2 text-white/90 hover:text-blue-200 hover:bg-white/10 text-[0.85rem] transition-colors">Volatility Database (VOL2G)</a>
              </div>
            </div>
          </div>
          <div class="relative group">
            <button class="flex items-center gap-1 hover:text-blue-200 transition-colors duration-200 cursor-pointer">Product Offerings <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button>
            <div class="absolute top-full right-0 pt-2 hidden group-hover:block z-50">
              <div class="bg-sr-navy border border-white/20 rounded-lg shadow-2xl p-6 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-5 min-w-[400px] lg:min-w-[720px] max-w-[calc(100vw-3rem)]">
                <div><p class="text-white/45 text-[11px] font-bold uppercase tracking-wider mb-2 px-2 select-none">Real-Time Data</p><a href="/data/stocks-options-futures/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">Market Data Feeds</a><a href="/data/options-analytics/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">Options Analytics</a></div><div><p class="text-white/45 text-[11px] font-bold uppercase tracking-wider mb-2 px-2 select-none">Historical Data</p><a href="/data/historical-data-analytics/options-greeks-stock-prices/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">Options, Greeks &amp; Stock Prices</a><a href="/data/option-features-dataset/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">Option Features Dataset</a></div><div><p class="text-white/45 text-[11px] font-bold uppercase tracking-wider mb-2 px-2 select-none">Volatility</p><a href="/data/historical-data-analytics/volatility-surfaces/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">Volatility Surfaces</a><a href="/data/historical-data-analytics/vol2g/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">Volatility Database (VOL2G)</a></div><div><p class="text-white/45 text-[11px] font-bold uppercase tracking-wider mb-2 px-2 select-none">MLink API</p><a href="/data/spiderstream-market-data-api/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">SpiderStream / MLink API</a><a href="/data/options-pricing-tool/" class="block px-2 py-1.5 text-white/90 hover:text-blue-200 hover:bg-white/10 rounded text-[0.85rem] transition-colors">Options Pricing Tool</a></div>
              </div>
            </div>
          </div>
          <div class="relative group">
            <button class="flex items-center gap-1 text-blue-200 transition-colors duration-200 cursor-pointer">Resources <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button>
            <div class="absolute top-full left-0 pt-2 hidden group-hover:block z-50">
              <div class="bg-sr-navy border border-white/20 rounded-lg shadow-2xl py-2 min-w-[210px]">
                <a href="/data/market-data-partners/" class="block px-4 py-2 text-white/90 hover:text-blue-200 hover:bg-white/10 text-[0.85rem] transition-colors">Market Data Partners</a><a href="/data/updates/" class="block px-4 py-2 text-white/90 hover:text-blue-200 hover:bg-white/10 text-[0.85rem] transition-colors">News &amp; Events</a><a href="/data/aws-infrastructure/" class="block px-4 py-2 text-white/90 hover:text-blue-200 hover:bg-white/10 text-[0.85rem] transition-colors">AWS &amp; Infrastructure</a>
              </div>
            </div>
          </div>
          <a href="/contact-us/" class="hover:text-blue-200 transition-colors duration-200">Contact</a>
        </div>
      </div>
    </nav>
  </div>

  <section class="bg-gradient-to-br from-sr-navy via-sr-blue to-sr-navy text-white hero-with-nav">
    <div class="max-w-7xl mx-auto px-8 py-16 pb-28">
      <p class="text-blue-300 text-sm font-semibold uppercase tracking-widest mb-5">Data &amp; Analytics</p>
      <h1 class="font-display text-[52px] md:text-[64px] font-bold leading-tight mb-6 max-w-3xl">
