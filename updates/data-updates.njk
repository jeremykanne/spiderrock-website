          <h4 class="text-white font-bold mb-6 text-sm uppercase tracking-wide">Company</h4>
          <ul class="space-y-3 text-gray-400 text-sm">
            <li><a href="/about-us/" class="hover:text-white transition-colors">Leadership</a></li>
