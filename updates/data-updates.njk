      </h1>
      <p class="text-white/80 text-xl max-w-2xl leading-relaxed">
        Product announcements, industry insights, and research from the SpiderRock data team.
      </p>
    </div>
  </section>

  <!-- DATA & ANALYTICS NEWS (generated from updates/posts/*.md tagged "Data & Analytics") -->
  <section class="bg-white py-28">
    <div class="max-w-7xl mx-auto px-8">
{%- if pagination.pageNumber == 0 %}
      {%- set featured = collections.dataPosts | head(3) %}
      {% include "partials/latest-news.njk" %}
{%- endif %}

      <div>
        <p class="text-sr-red text-sm font-semibold uppercase tracking-widest mb-8">{% if pagination.pageNumber == 0 %}More Data &amp; Analytics Updates{% else %}Data &amp; Analytics Updates &mdash; Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}{% endif %}</p>
        <div class="divide-y divide-gray-200">
{%- for post in rows %}
{% include "partials/news-row.njk" %}
{%- endfor %}
        </div>
      </div>

      {%- set pager = { hrefs: pagination.hrefs, current: pagination.pageNumber, previous: pagination.href.previous, next: pagination.href.next } %}
      {% include "partials/pager.njk" %}
    </div>
  </section>

  <!-- FULL ARCHIVE CTA -->
  <section class="bg-sr-navy py-24">
    <div class="max-w-4xl mx-auto px-8 text-center">
      <h2 class="font-display text-4xl font-bold text-white mb-6">Full Article Archive</h2>
      <p class="text-white/70 text-lg mb-10 max-w-2xl mx-auto">Browse all {{ collections.posts.length }} SpiderRock updates, including trading platform news, events, and white papers.</p>
      <a href="/updates/" class="inline-block bg-sr-red text-white font-semibold px-10 py-4 button-smooth text-lg">View All Updates</a>
    </div>
  </section>

  <!-- NEWSLETTER / AC FORM -->
  <section id="subscribe" class="bg-white py-28 border-t border-gray-200 scroll-mt-[150px]">
    <div class="max-w-3xl mx-auto px-8">
      <p class="text-sr-red text-sm font-semibold uppercase tracking-widest mb-4">Newsletter</p>
      <h2 class="font-display text-4xl font-bold text-gray-900 mb-4">Join Our Email List</h2>
      <p class="text-gray-600 text-lg leading-relaxed mb-10">Sign up to get technology and product announcements from SpiderRock.</p>

      <!-- ActiveCampaign form 5 (srock.activehosted.com) -->
      <div class="_form_5 ac-form"></div>
      <script src="https://srock.activehosted.com/f/embed.php?id=5" type="text/javascript" charset="utf-8"></script>
      <script>
            // AC scopes its button/error CSS with the form's generated id, which outranks any
            // class rule. Mirror that specificity, appended after their <style> to win on a tie.
            (function () {
              var wrap = document.querySelector('.ac-form');
              function paint(form) {
                var id = form.id;
                if (!id) return;
                var css = [
                  '#' + id + '{max-width:100%!important;width:100%!important}',
                  '#' + id + ' ._submit{width:100%!important;background:#162032!important;color:#fff!important;font-weight:600!important;font-size:1rem!important;border:none!important;border-radius:0!important;padding:1rem 2rem!important;cursor:pointer;transition:all 200ms cubic-bezier(0.4,0,0.2,1)}',
                  '#' + id + ' ._submit:hover{background:#1B3D6B!important;transform:translateY(-2px);box-shadow:0 12px 24px rgba(0,0,0,0.15)}',
                  '#' + id + ' ._form-fieldset label{display:inline-flex!important;align-items:center;width:auto!important;float:none!important;margin:0 0 0 0.6rem!important;font-size:0.875rem!important;font-weight:400!important;color:#374151!important;vertical-align:middle}',
                  '#' + id + ' ._form-fieldset ._row,#' + id + ' ._form-fieldset ._checkbox-radio{margin:0 0 0.5rem 0!important;display:block!important}',
                  '#' + id + ' ._form-fieldset input[type="radio"],#' + id + ' ._form-fieldset input[type="checkbox"]{width:1rem!important;height:1rem!important;margin:0!important;accent-color:#162032;vertical-align:middle}',
                  '#' + id + ' ._form-fieldset{border:0!important;padding:0!important;margin:0!important}',
                  '#' + id + ' ._form-title{display:none!important}',
                  '#' + id + ' ._form_element:has(._form-title){display:none!important;margin:0!important}',
                  '#' + id + ' ._html-code,#' + id + ' ._html-code p{font-size:0.75rem!important;color:#9CA3AF!important}',
                  '#' + id + ' ._html-code a{color:#1B3D6B!important;text-decoration:underline}',
                  '#' + id + ' ._error-inner,#' + id + ' ._error-html,#' + id + ' ._error-inner._form_error{background:#C0392B!important;color:#fff!important;border-radius:0.375rem!important;font-size:0.8125rem!important}',
                  '#' + id + ' ._error-arrow{border-bottom-color:#C0392B!important}',
                  '#' + id + ' ._form-thank-you{color:#111827!important;text-align:left!important;font-size:1rem!important}'
                ].join('');
                var st = document.createElement('style');
                st.textContent = css;
                wrap.appendChild(st);
              }
              var form = wrap.querySelector('form');
              if (form) return paint(form);
              new MutationObserver(function (_m, obs) {
                var f = wrap.querySelector('form');
                if (f) { obs.disconnect(); paint(f); }
              }).observe(wrap, { childList: true, subtree: true });
            })();
      </script>
      <p class="text-gray-400 text-xs mt-6">By submitting this form you agree to SpiderRock&rsquo;s privacy policy. For institutional &amp; professional clients only.</p>
    </div>
  </section>

