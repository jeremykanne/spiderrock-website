---
pagination:
  data: collections.dataOlderPosts
  size: 20
  alias: rows
permalink: "data/updates/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Updates — SpiderRock Data &amp; Analytics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Roboto', 'sans-serif'], display: ['Montserrat', 'sans-serif'] },
          colors: { 'sr-navy': '#162032', 'sr-blue': '#1B3D6B', 'sr-gray': '#5C6270', 'sr-dark': '#3A3F4A', 'sr-red': '#C0392B' },
        },
      },
    };
  </script>
  <style>
    html { scroll-behavior: smooth; }
    .button-smooth { transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1); }
    .button-smooth:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(0,0,0,0.15); }
    .card-hover { transition: all 200ms ease; }
    .card-hover:hover { transform: translateY(-3px); box-shadow: 0 16px 32px rgba(0,0,0,0.10); }
    /* ── ActiveCampaign form 40, restyled to match the site ──────────────────
       CSS only: AC's markup, field names, validation and submit path are untouched. */
    .ac-form { max-width: 100%; }
    .ac-form ._form,
    .ac-form ._form_element,
    .ac-form ._form-content,
    .ac-form ._field-wrapper { all: unset; display: block; width: 100%; box-sizing: border-box; }
    .ac-form ._form { margin: 0 !important; padding: 0 !important; background: none !important; }
    .ac-form ._form_element { margin: 0 0 1.25rem 0 !important; }
    .ac-form,
    .ac-form input, .ac-form textarea, .ac-form select, .ac-form button, .ac-form label {
      font-family: 'Roboto', sans-serif !important;
    }
    /* AC serves its own form title (e.g. "Options Analytics"); the page heading above
       already names the section, so suppress it. :has() collapses the empty wrapper too. */
    .ac-form ._form-title { display: none !important; }
    .ac-form ._form_element:has(._form-title) { display: none !important; margin: 0 !important; }
    .ac-form ._form-label {
      display: block !important;
      font-size: .875rem !important;
      font-weight: 600 !important;
      color: #374151 !important;
      margin: 0 0 .5rem 0 !important;
    }
    .ac-form .field-required { color: #C0392B !important; margin-left: .15rem; }
    .ac-form input[type="text"],
    .ac-form input[type="email"],
    .ac-form input[type="tel"],
    .ac-form textarea {
      width: 100% !important;
      box-sizing: border-box !important;
      border: 1px solid #D1D5DB !important;
      border-radius: .5rem !important;
      padding: .75rem 1rem !important;
      font-size: 1rem !important;
      color: #111827 !important;
      background: #fff !important;
      box-shadow: none !important;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .ac-form textarea { min-height: 8.5rem; resize: none !important; }
    .ac-form input::placeholder, .ac-form textarea::placeholder { color: #9CA3AF !important; }
    .ac-form input[type="text"]:focus,
    .ac-form input[type="email"]:focus,
    .ac-form textarea:focus {
      outline: none !important;
      border-color: transparent !important;
      box-shadow: 0 0 0 2px #1B3D6B !important;
    }
    .ac-form ._button-wrapper { margin-top: .25rem !important; }
    .ac-form button._submit {
      width: 100% !important;
      background: #162032 !important;
      color: #fff !important;
      font-weight: 600 !important;
      font-size: 1rem !important;
      border: none !important;
      border-radius: 0 !important;
      padding: 1rem 2rem !important;
      cursor: pointer;
      transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .ac-form button._submit:hover {
      background: #1B3D6B !important;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.15);
    }
    .ac-form ._html-code, .ac-form ._html-code p { font-size: .75rem !important; color: #9CA3AF !important; margin: 0 !important; }
    .ac-form ._html-code a { color: #1B3D6B !important; text-decoration: underline; }
    .ac-form ._error, .ac-form ._error-inner, .ac-form ._error-html {
      background: #C0392B !important; color: #fff !important;
      border-radius: .375rem !important; font-size: .8125rem !important;
    }
    .ac-form ._error-arrow { border-bottom-color: #C0392B !important; }
    .ac-form ._form-thank-you { font-size: 1rem !important; color: #111827 !important; text-align: left !important; }
    /* AC's own radio rows ("I'm interested in") */
    .ac-form ._form_element._checkbox-radio ._row { margin: 0 0 .5rem 0 !important; }
    .ac-form ._checkbox-radio label { display: flex !important; align-items: center; gap: .75rem;
      font-size: .875rem !important; font-weight: 400 !important; color: #374151 !important; cursor: pointer; margin: 0 !important; }
    .ac-form input[type="radio"], .ac-form input[type="checkbox"] {
      width: 1rem !important; height: 1rem !important; margin: 0 !important; accent-color: #162032; flex: none; }
    /* reCAPTCHA widget renders in a fixed-width iframe — keep it inside the column */
    .ac-form .g-recaptcha { margin: 0 0 1.25rem 0 !important; transform-origin: 0 0; max-width: 100%; }
    .ac-form .g-recaptcha > div { max-width: 100% !important; }
    .ac-form ._form_element, .ac-form ._form-content, .ac-form input, .ac-form textarea, .ac-form select { max-width: 100% !important; box-sizing: border-box; }
    .ac-form ._form { margin: 0 !important; padding: 0 !important; width: 100% !important; }
    /* ── Sticky header ──────────────────────────────────────────────────────
       The utility bar stays sticky in flow. The primary nav is fixed just below it
       so it keeps overlaying the hero exactly as before, and picks up a solid
       background + shadow once the page scrolls (.is-stuck, toggled in script). */
    .site-nav {
      position: fixed;
      top: var(--util-h, 45px);
      left: 0; right: 0;
      z-index: 60;              /* above the utility bar (z-50) so the logo can overlap it */
      background: transparent;
      transition: background-color 200ms ease, box-shadow 200ms ease;
    }
    .site-nav.is-stuck {
      background: #162032;
      box-shadow: 0 6px 20px rgba(0,0,0,0.22);
    }
    /* Compact once stuck: tighter padding and a smaller logo, so the header gives
       back vertical space while scrolling. Logo height is inline, hence !important. */
    .site-nav nav { transition: padding-top 200ms ease, padding-bottom 200ms ease; }
    .site-nav img { transition: height 200ms ease; }
    .site-nav.is-stuck nav { padding-top: 0.6rem; padding-bottom: 0.6rem; }
    /* Logo keeps its full size when compact by overlapping the utility bar above it.
       Negative margins stop it from driving the bar's height; the raised z-index lets it
       paint over the utility bar (both are navy, so the overlap is seamless). */
    .site-nav.is-stuck img { height: 45px !important; margin-top: -13px; margin-bottom: -13px;
      position: relative; top: -11px; }   /* rides up into the utility bar */
    @media (prefers-reduced-motion: reduce) {
      .site-nav nav, .site-nav img { transition: none; }
    }
    .hero-with-nav { padding-top: var(--nav-h, 93px); }
    @media (prefers-reduced-motion: reduce) { .site-nav { transition: none; } }
  </style>
</head>
<body class="font-sans antialiased text-gray-900">

  <!-- UTILITY BAR -->
