<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} — SpiderRock</title>
  <meta name="description" content="{{ summary }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/js/tailwind-config.js"></script>
  <link rel="stylesheet" href="/css/site.css" />
  <style>
    .prose h2 { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; font-weight: 700; color: #2C4660; margin-top: 2rem; margin-bottom: 0.75rem; }
    .prose h3 { font-family: 'Montserrat', sans-serif; font-size: 1.15rem; font-weight: 700; color: #2C4660; margin-top: 1.5rem; margin-bottom: 0.5rem; }
    .prose p { color: #3B3F40; line-height: 1.8; margin-bottom: 1.25rem; }
    .prose ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.25rem; }
    .prose ol { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1.25rem; }
    .prose ul li, .prose ol li { color: #3B3F40; line-height: 1.8; margin-bottom: 0.25rem; }
    .prose a { color: #3C5E80; text-decoration: underline; }
    .prose h4 { font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 700; color: #2C4660; margin-top: 1.25rem; margin-bottom: 0.5rem; }
    .prose img { max-width: 100%; height: auto; margin: 1.5rem 0; border-radius: 0.5rem; }
    .prose blockquote { border-left: 3px solid #BA4838; padding-left: 1rem; margin: 0 0 1.25rem; }
    .prose .video-embed { position: relative; aspect-ratio: 16 / 9; margin: 1.5rem 0; }
    .prose .video-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 0.5rem; }

    /* ActiveCampaign contact form — same styling as the product pages */
    .ac-form { max-width: 100%; }
    .ac-form ._form,
    .ac-form ._form_element,
    .ac-form ._form-content,
    .ac-form ._field-wrapper { all: unset; display: block; width: 100%; box-sizing: border-box; }
    .ac-form ._form { margin: 0 !important; padding: 0 !important; background: none !important; }
    .ac-form ._form_element { margin: 0 0 1.25rem 0 !important; }
    .ac-form,
    .ac-form input, .ac-form textarea, .ac-form select, .ac-form button, .ac-form label {
      font-family: 'Roboto', sans-serif !important;
    }
    /* AC serves its own form title (e.g. "Options Analytics"); the page heading above
       already names the section, so suppress it. :has() collapses the empty wrapper too. */
    .ac-form ._form-title { display: none !important; }
    .ac-form ._form_element:has(._form-title) { display: none !important; margin: 0 !important; }
    .ac-form ._form-label {
      display: block !important;
      font-size: .875rem !important;
      font-weight: 600 !important;
      color: #374151 !important;
      margin: 0 0 .5rem 0 !important;
    }
    .ac-form .field-required { color: #BA4838 !important; margin-left: .15rem; }
    .ac-form input[type="text"],
    .ac-form input[type="email"],
    .ac-form input[type="tel"],
    .ac-form textarea {
      width: 100% !important;
      box-sizing: border-box !important;
      border: 1px solid #D1D5DB !important;
      border-radius: .5rem !important;
      padding: .75rem 1rem !important;
      font-size: 1rem !important;
      color: #111827 !important;
      background: #fff !important;
      box-shadow: none !important;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .ac-form textarea { min-height: 8.5rem; resize: none !important; }
    .ac-form input::placeholder, .ac-form textarea::placeholder { color: #9CA3AF !important; }
    .ac-form input[type="text"]:focus,
    .ac-form input[type="email"]:focus,
    .ac-form textarea:focus {
      outline: none !important;
      border-color: transparent !important;
      box-shadow: 0 0 0 2px #3C5E80 !important;
    }
    .ac-form ._button-wrapper { margin-top: .25rem !important; }
    .ac-form button._submit {
      width: 100% !important;
      background: #BA4838 !important;
      color: #fff !important;
      font-weight: 600 !important;
      font-size: 1rem !important;
      border: none !important;
      border-radius: 6px !important; min-height: 52px !important;
      padding: 1rem 2rem !important;
      cursor: pointer;
      transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .ac-form button._submit:hover {
      background: #A03C2E !important;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.15);
    }
    .ac-form ._html-code, .ac-form ._html-code p { font-size: .75rem !important; color: #9CA3AF !important; margin: 0 !important; }
    .ac-form ._html-code a { color: #3C5E80 !important; text-decoration: underline; }
    .ac-form ._error, .ac-form ._error-inner, .ac-form ._error-html {
      background: #BA4838 !important; color: #fff !important;
      border-radius: .375rem !important; font-size: .8125rem !important;
    }
    .ac-form ._error-arrow { border-bottom-color: #BA4838 !important; }
    .ac-form ._form-thank-you { font-size: 1rem !important; color: #111827 !important; text-align: left !important; }
  </style>
</head>
<body class="font-sans antialiased text-gray-900">

  <!-- UTILITY BAR -->
  <div class="bg-sr-charcoal text-white/80 text-[0.85rem] font-semibold h-11 sticky top-0 z-50">
    <div class="wrap h-full flex justify-end items-center gap-8">
      <a href="../../" class="hover:text-white transition-colors duration-200">Home</a>
      <a href="../../platform/" class="hover:text-white transition-colors duration-200">Trading Platform</a>
      <a href="../../exs/" class="hover:text-white transition-colors duration-200">Brokerage Services</a>
      <a href="../../data/" class="hover:text-white transition-colors duration-200">Data &amp; Analytics</a>
    </div>
  </div>

  <!-- HERO -->
  <!-- PRIMARY NAV — lifted out of the hero so it can stick; overlays the hero via
       position:fixed, and goes compact once scrolled (see .is-stuck). -->
  <div id="siteNav" class="site-nav">
    <nav class="w-full py-6">
      <div class="wrap flex justify-between items-center">
        <a href="../../" class="hover:opacity-80 transition-opacity">
          <img src="../../logos/Horizontal/Vector/SVG/SpiderRock - Logo - Horizontal - Color - Reversed.svg" alt="SpiderRock" style="height:46px;">
        </a>
        <div class="hidden md:flex items-center gap-10 text-white/90 text-[16px] font-bold">
          <a href="../../about-us/" class="hover:text-white transition-colors duration-200">Leadership</a>
          <a href="../../careers/" class="hover:text-white transition-colors duration-200">Careers</a>
          <a href="../../updates/" class="nav-active">News</a>
          <a href="../../contact-us/" class="hover:text-white transition-colors duration-200">Contact</a>
        </div>
      </div>
    </nav>
  </div>

  <section class="hero-steel text-white hero-with-nav">
    <div class="wrap py-16 pb-20">
      <a href="../../updates/" class="text-blue-300 text-sm hover:text-white transition-colors mb-6 block w-fit">&larr; All Updates</a>
      <p class="eyebrow eyebrow-dark mb-4">News &amp; Updates</p>
      <h1 class="hero-h1-sm mb-4 max-w-4xl">{{ title }}</h1>
      <p class="text-white/60 text-sm"><time datetime="{{ page.date | isoDate }}">{{ page.date | dateLong }}</time></p>
    </div>
  </section>

  <!-- ARTICLE BODY -->
  <section class="bg-white py-20">
    <div class="max-w-3xl mx-auto px-8">
      <div class="prose">
{{ content | safe }}
      </div>
    </div>
  </section>

{%- if "_form_" not in content %}
  <!-- CONTACT FORM: ActiveCampaign form 40, the form under every post on spiderrock.net.
       Skipped on posts that carry their own form in the article (white-paper downloads). -->
  <section id="contact" class="bg-white py-28 border-t border-gray-200 scroll-mt-[150px]">
    <div class="max-w-3xl mx-auto px-8">
      <p class="eyebrow mb-4">Contact Us</p>
      <h2 class="h2 text-gray-900 mb-4">Have any questions?</h2>
      <p class="text-gray-600 text-lg leading-relaxed mb-10">Fill out the form below and we&rsquo;ll get back to you as soon as possible.</p>

      <div class="_form_40 ac-form"></div>
      <script src="https://srock.activehosted.com/f/embed.php?id=40" type="text/javascript" charset="utf-8"></script>
      <p class="text-gray-400 text-xs mt-6">By submitting this form you agree to SpiderRock&rsquo;s privacy policy. For institutional &amp; professional clients only.</p>
    </div>
  </section>
{%- endif %}

  <!-- AC FORM STYLING -->
  <script>
            // Styles every ActiveCampaign form on the page (contact form and white-paper downloads).
            // AC scopes its button/error CSS with the form's generated id, which outranks any
            // class rule. Mirror that specificity, appended after their <style> to win on a tie.
            (function () {
              document.querySelectorAll('.ac-form').forEach(function (wrap) {
              function paint(form) {
                var id = form.id;
                if (!id) return;
                var css = [
                  '#' + id + '{max-width:100%!important;width:100%!important}',
                  '#' + id + ' ._submit{width:100%!important;min-height:52px!important;border-radius:6px!important;background:#BA4838!important;color:#fff!important;font-weight:600!important;font-size:1rem!important;border:none!important;border-radius:0!important;padding:1rem 2rem!important;cursor:pointer;transition:all 200ms cubic-bezier(0.4,0,0.2,1)}',
                  '#' + id + ' ._submit:hover{background:#A03C2E!important;transform:translateY(-2px);box-shadow:0 12px 24px rgba(0,0,0,0.15)}',
                  '#' + id + ' ._form-fieldset label{display:inline-flex!important;align-items:center;width:auto!important;float:none!important;margin:0 0 0 0.6rem!important;font-size:0.875rem!important;font-weight:400!important;color:#374151!important;vertical-align:middle}',
                  '#' + id + ' ._form-fieldset ._row,#' + id + ' ._form-fieldset ._checkbox-radio{margin:0 0 0.5rem 0!important;display:block!important}',
                  '#' + id + ' ._form-fieldset input[type="radio"],#' + id + ' ._form-fieldset input[type="checkbox"]{width:1rem!important;height:1rem!important;margin:0!important;accent-color:#2C4660;vertical-align:middle}',
                  '#' + id + ' ._form-fieldset{border:0!important;padding:0!important;margin:0!important}',
                  '#' + id + ' ._form-title{display:none!important}',
                  '#' + id + ' ._form_element:has(._form-title){display:none!important;margin:0!important}',
                  '#' + id + ' ._html-code,#' + id + ' ._html-code p{font-size:0.75rem!important;color:#9CA3AF!important}',
                  '#' + id + ' ._html-code a{color:#3C5E80!important;text-decoration:underline}',
                  '#' + id + ' ._error-inner,#' + id + ' ._error-html,#' + id + ' ._error-inner._form_error{background:#BA4838!important;color:#fff!important;border-radius:0.375rem!important;font-size:0.8125rem!important}',
                  '#' + id + ' ._error-arrow{border-bottom-color:#BA4838!important}',
                  '#' + id + ' ._form-thank-you{color:#111827!important;text-align:left!important;font-size:1rem!important}'
                ].join('');
                var st = document.createElement('style');
                st.textContent = css;
                wrap.appendChild(st);
              }
              var form = wrap.querySelector('form');
              if (form) return paint(form);
              new MutationObserver(function (_m, obs) {
                var f = wrap.querySelector('form');
                if (f) { obs.disconnect(); paint(f); }
              }).observe(wrap, { childList: true, subtree: true });
              });
            })();
      </script>

{% include "partials/footer.njk" %}

  <script>
    // Measure the two bars so the fixed nav and the hero offset stay in sync with
    // whatever the real rendered heights are (font loading, wrapping, zoom).
    (function () {
      var util = document.querySelector('.sticky.top-0');
      var nav  = document.getElementById('siteNav');
      if (!util || !nav) return;
      function measure() {
        var wasStuck = nav.classList.contains('is-stuck');
        if (wasStuck) nav.classList.remove('is-stuck');   // measure the expanded height
        document.documentElement.style.setProperty('--util-h', util.offsetHeight + 'px');
        document.documentElement.style.setProperty('--nav-h',  nav.offsetHeight  + 'px');
        if (wasStuck) nav.classList.add('is-stuck');
      }
      function onScroll() { nav.classList.toggle('is-stuck', window.scrollY > 8); }
      measure(); onScroll();
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', measure);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    })();
  </script>
</body>
</html>
