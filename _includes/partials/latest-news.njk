{#- "Latest News": the newest post as a navy lead story plus the next two as cards. Expects `featured` (3 posts). -#}
      {%- set lead = featured[0] %}
      <div class="mb-20">
        <p class="text-sr-red text-sm font-semibold uppercase tracking-widest mb-8">Latest News</p>
        <div class="grid lg:grid-cols-3 gap-6">
          <article class="lg:col-span-2 bg-gradient-to-br from-sr-navy via-sr-blue to-sr-navy text-white rounded-xl p-8 md:p-12 flex flex-col justify-center">
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <span class="text-xs font-bold uppercase tracking-widest text-blue-300">Latest</span>
              {%- for c in lead.data.categories %}<span class="text-xs bg-white/10 border border-white/20 text-white/90 px-2 py-1 rounded">{{ c }}</span>{% endfor %}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-4"><a href="{{ lead.url }}" class="hover:text-blue-200 transition-colors">{{ lead.data.title }}</a></h2>
            <p class="text-white/60 text-sm mb-6"><time datetime="{{ lead.date | isoDate }}">{{ lead.date | dateLong }}</time></p>
            {%- if lead.data.summary %}
            <p class="text-white/80 text-lg leading-relaxed mb-8 max-w-2xl">{{ lead.data.summary }}</p>
            {%- endif %}
            <a href="{{ lead.url }}" class="self-start inline-block bg-sr-red text-white font-semibold px-6 py-3 button-smooth">Read More →</a>
          </article>
          <div class="grid gap-6">
{%- for post in featured | tail(1) %}
            <article class="bg-gray-50 border border-gray-200 border-l-4 border-l-sr-navy rounded-xl p-6 flex flex-col hover:shadow-lg transition-shadow">
              <div class="flex gap-2 flex-wrap mb-3">{% for c in post.data.categories %}<span class="text-xs bg-white border border-gray-200 text-gray-600 px-2 py-1 rounded">{{ c }}</span>{% endfor %}</div>
              <h3 class="font-display font-bold text-gray-900 leading-snug text-lg mb-2"><a href="{{ post.url }}" class="hover:text-sr-blue transition-colors">{{ post.data.title }}</a></h3>
              <p class="text-gray-500 text-sm mb-3"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateShort }}</time></p>
              {%- if post.data.summary %}
              <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3">{{ post.data.summary }}</p>
              {%- endif %}
              <a href="{{ post.url }}" class="mt-auto text-sr-blue font-semibold text-sm hover:underline">Read More →</a>
            </article>
{%- endfor %}
          </div>
        </div>
      </div>

