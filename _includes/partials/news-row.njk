{#- One post in the News & Updates list. Expects `post`. -#}
          <article class="py-6 flex flex-col md:flex-row md:items-start gap-4">
            <div class="flex-shrink-0 text-gray-400 text-sm w-28"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateShort }}</time></div>
            <div class="flex-1">
              <div class="flex gap-2 flex-wrap mb-2">{% for c in post.data.categories %}<span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{{ c }}</span>{% endfor %}</div>
              <h3 class="font-semibold text-gray-900 mb-1">{{ post.data.title }}</h3>
              <p class="text-gray-600 text-sm mb-2">{{ post.data.summary }}</p>
              <a href="{{ post.url }}" class="text-sr-blue font-semibold text-sm hover:underline">Read More →</a>
            </div>
          </article>
